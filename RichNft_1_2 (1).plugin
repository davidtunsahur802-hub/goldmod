        f2, _e2 = ui_field(ctx, "Gram", self._ui_get("gram_value", "0"),
                            lambda s: self._ui_set("gram_value", s), numeric=True)
        card.addView(f2, ui_lin(-1, -2, None, (0, 10, 0, 6)))
        sw3, _ = ui_switch_row(
            ctx, "Списывать визуальный баланс",
            "При нехватке откроется штатное окно Telegram; платёж не запускается автоматически",
            self._bool("charge_visual_gifts", False),
            lambda v: self._ui_set("charge_visual_gifts", v))
        card.addView(sw3, ui_lin(-1, -2, None, (0, 6, 0, 4)))
        root.addView(sec, ui_lin(-1, -2, None, (0, 0, 0, 16)))

        sec, card = ui_section(ctx, "Рейтинг")
        lvl = max(1, min(99, self._int_setting("rating_level", 10)))
        card.addView(ui_row(
            ctx, "Рейтинг и рамка бейджа", "Уровень: %d" % lvl,
            on_click=lambda v: self._ui_open_rating()),
            ui_lin(-1, -2, None, (0, 6, 0, 6)))
        root.addView(sec, ui_lin(-1, -2, None, (0, 0, 0, 16)))

        sec, card = ui_section(ctx, "Бейдж верификации")
        chips = _LinearLayout(ctx)
        chips.setOrientation(_LinearLayout.HORIZONTAL)
        mode = self._badge_mode()

        def set_mode(m):
            if self.ui_sheet_alive():
