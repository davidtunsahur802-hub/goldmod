        card.addView(sw, ui_lin(-1, -2, None, (0, 4, 0, 0)))
        card.addView(ui_row(ctx, "Добавить NFT-юзернеймы", "Можно несколько через запятую",
                            on_click=lambda v: self._input("юзернеймы (через запятую)", "",
                                                           self._add_visual_usernames)),
                     ui_lin(-1, -2, None, (0, 8, 0, 0)))
        card.addView(ui_row(ctx, "Выданные юзернеймы", "%d сохранено" % len(names),
                            on_click=lambda v: self._show_visual_username_list(names)),
                     ui_lin(-1, -2))
        if names:
            card.addView(ui_row(ctx, "Очистить всё", "Удалить все юзернеймы",
                                on_click=lambda v: self._clear_visual_usernames()),
                         ui_lin(-1, -2, None, (0, 0, 0, 6)))
        root.addView(sec, ui_lin(-1, -2, None, (0, 0, 0, 16)))

        sec, card = ui_section(ctx, "Прочее")
        sw, _ = ui_switch_row(
            ctx, "Конфетти", "При отправке",
            self._bool("confetti", True),
            lambda v: self._ui_set("confetti", v))
        card.addView(sw, ui_lin(-1, -2, None, (0, 4, 0, 0)))
        sw2, _ = ui_switch_row(
            ctx, "Подробные логи", "Писать отладочные сообщения в буфер",
            self._bool("debug_log", False),
            lambda v: self._ui_set("debug_log", v))
        card.addView(sw2, ui_lin(-1, -2, None, (0, 8, 0, 0)))
        row = _LinearLayout(ctx)
        row.setOrientation(_LinearLayout.HORIZONTAL)
        row.addView(ui_tonal_btn(ctx, "Отправить логи", lambda v: self._share_logs_click()),
                    ui_lin(0, -2, 1, (0, 0, 4, 0)))
        row.addView(ui_outlined_btn(ctx, "Очистить", lambda v: self._clear_logs_click()),
                    ui_lin(0, -2, 1, (4, 0, 0, 0)))
        card.addView(row, ui_lin(-1, -2, None, (0, 10, 0, 6)))
        root.addView(sec, ui_lin(-1, -2))

        if embedded:
            return root
        self.ui_show_sheet(root, max_height=0.85, scroll_y=target_scroll)

    def _ui_set_level(self, n):
        n = max(1, min(99, int(n)))
        self._ui_set("rating_level", str(n))
        try:
            self._ui_repaint()
        except Exception:
            pass
        try:
            self._post_user_info_did_load("ui-level")
        except Exception:
            pass
        return n

    def _ui_shape_for_level(self, lv):

        lv = max(1, min(99, int(lv)))
        if lv <= 10:
            return lv
        return min(90, (lv // 10) * 10)

    def _ui_shape(self):

        lvl = max(1, min(99, self._int_setting("rating_level", 10)))
        if self._bool("rating_shape_follow", True):
            return self._ui_shape_for_level(lvl)
        stored = self._int_setting("rating_shape", 0)
        if stored in ui_SHAPE_LEVELS:
            return stored
        return self._ui_shape_for_level(lvl)

    def _ui_set_shape(self, n):
        n = int(n)
        if n not in ui_SHAPE_LEVELS:
            n = self._ui_shape_for_level(n)
        self._ui_set("rating_shape", str(n))
        self._ui_set("rating_custom_enabled", False)
        try:
            self._ui_repaint()
        except Exception:
            pass
        try:
            self._post_user_info_did_load("ui-shape")
        except Exception:
            pass
        return n

    def _ui_custom_badge_points(self):
        try:
            raw = self._ui_get("rating_custom_outline", "")
            data = json.loads(str(raw)) if raw else []
            points = []
            for point in data[:180]:
                if not isinstance(point, (list, tuple)) or len(point) < 2:
                    continue
                x = max(3.0, min(97.0, float(point[0])))
                y = max(3.0, min(97.0, float(point[1])))
                if not points or _math.hypot(points[-1][0] - x, points[-1][1] - y) >= 0.25:
                    points.append((x, y))
            return points if len(points) >= 3 else []
        except Exception:
            return []

    def _ui_save_custom_badge(self, points):
        try:
            clean = [[round(max(3.0, min(97.0, float(p[0]))), 1),
                      round(max(3.0, min(97.0, float(p[1]))), 1)]
                     for p in points[:180]]
            if len(clean) < 3:
                self.ui_toast("Нарисуй контур минимум из трёх точек")
                return
            self._ui_set("rating_custom_outline", json.dumps(clean, separators=(",", ":")))
            self._ui_set("rating_custom_enabled", True)
            self._ui_set("rating_shape_follow", False)
            self._ui_repaint()
            try:
                self._post_user_info_did_load("ui-custom-shape")
            except Exception:
                pass
            self._ui_build_rating()
        except Exception as e:
            self._log("custom badge save: %s" % e)
            self.ui_toast("Не удалось сохранить форму")

    def _ui_build_badge_drawer(self, *args):
        try:
            if self.ui_sheet_alive() and getattr(self, "_ui_screen", "") == "rating":
                self._ui_rating_scroll_y = int(self._ui_sheet_sv.getScrollY())
        except Exception:
            self._ui_rating_scroll_y = 0
        self._ui_screen = "badge_drawer"
        ctx = self.ui_activity()
        root = _LinearLayout(ctx)
        root.setOrientation(_LinearLayout.VERTICAL)
        root.setPadding(ui_dp(16), ui_dp(18), ui_dp(16), ui_dp(24))
        root.addView(self.ui_sheet_header(
            ctx, "Своя форма", "Нарисуй замкнутый контур пальцем",
            left=lambda v: self._ui_build_rating()),
            ui_lin(-1, -2, None, (0, 0, 0, 14)))
        state = {"points": self._ui_custom_badge_points()}
        area = _FrameLayout(ctx)
        field = _FrameLayout(ctx)
        ui_set_bg(field, ui_rounded(UI_PALETTE["surface_container_high"], 24))
        try:
            field.setClipToOutline(True)
        except Exception:
            pass
        sketch = _ImageView(ctx)
        sketch.setScaleType(_ImageView.ScaleType.FIT_XY)
        field.addView(sketch, ui_frm(-1, -1))
        area.addView(field, ui_frm(ui_dp(260), ui_dp(260), _Gravity.CENTER))
        root.addView(area, ui_lin(-1, ui_dp(276), None, (0, 0, 0, 10)))
        preview_card = _LinearLayout(ctx)
        preview_card.setOrientation(_LinearLayout.HORIZONTAL)
        preview_card.setGravity(_Gravity.CENTER_VERTICAL)
        preview_card.setPadding(ui_dp(14), ui_dp(12), ui_dp(14), ui_dp(12))
        ui_set_bg(preview_card, ui_rounded(UI_PALETTE["surface_container_high"], 22))
        avatar = _FrameLayout(ctx)
        ui_set_bg(avatar, ui_rounded(UI_PALETTE["primary_container"], 24))
        avatar.addView(ui_text(ctx, "Я", 18, UI_PALETTE["on_primary_container"], True, _Gravity.CENTER),
                       ui_frm(-1, -1))
        preview_card.addView(avatar, ui_lin(ui_dp(48), ui_dp(48), None, (0, 0, 12, 0)))
        preview_info = _LinearLayout(ctx)
        preview_info.setOrientation(_LinearLayout.VERTICAL)
        preview_info.addView(ui_body(ctx, "Профиль", 16, UI_PALETTE["on_surface"], True))
        rating_preview_text = ui_support(ctx, "Уровень рейтинга")
        preview_info.addView(rating_preview_text)
        preview_card.addView(preview_info, ui_lin(0, -2, 1))
        preview_badge_slot = _FrameLayout(ctx)
        preview_card.addView(preview_badge_slot, ui_lin(ui_dp(44), ui_dp(44), None, (8, 0, 0, 0)))
        preview_card.setVisibility(_View.GONE)
        preview_button = ui_outlined_btn(ctx, "Показать шапку профиля", lambda v: None)
        root.addView(preview_button, ui_lin(-1, -2, None, (0, 0, 0, 8)))
        root.addView(preview_card, ui_lin(-1, -2, None, (0, 0, 0, 10)))
        root.addView(ui_support(ctx, "Проведи контур одним движением. При сохранении линия замкнётся."),
                     ui_lin(-1, -2, None, (4, 0, 4, 12)))

        def update_profile_preview():
            try:
                preview_badge_slot.removeAllViews()
                lv = max(1, min(99, self._int_setting("rating_level", 10)))
                rating_preview_text.setText("Уровень рейтинга: %d" % lv)
                points = state["points"] if len(state["points"]) >= 3 else self._ui_custom_badge_points()
                if len(points) >= 3:
                    badge = ui_make_custom_badge(ctx, points, 38, lv,
                                                 UI_PALETTE["primary"],
                                                 UI_PALETTE["on_primary"], number=lv)
                else:
                    badge = ui_make_badge(ctx, self._ui_shape(), 38,
                                          UI_PALETTE["primary"],
                                          UI_PALETTE["on_primary"], number=lv)
                preview_badge_slot.addView(badge, ui_frm(ui_dp(38), ui_dp(38), _Gravity.CENTER))
            except Exception as e:
                self._log("profile header preview: %s" % e)

        def toggle_profile_preview(v):
            visible = int(preview_card.getVisibility()) == int(_View.VISIBLE)
            if visible:
                preview_card.setVisibility(_View.GONE)
                preview_button.setText("Показать шапку профиля")
            else:
                update_profile_preview()
                preview_card.setVisibility(_View.VISIBLE)
                preview_button.setText("Скрыть шапку профиля")

        ui_on_click(preview_button, toggle_profile_preview)

        def redraw():
            try:
                size = max(2, int(ui_dp(260)))
                bmp = _Bitmap.createBitmap(size, size, _Bitmap.Config.ARGB_8888)
                canvas = _Canvas(bmp)
                points = state["points"]
                if len(points) >= 3:
                    fill = Paint()
                    fill.setAntiAlias(True)
                    ui_set_paint_color(fill, UI_PALETTE["primary"])
                    fill.setAlpha(72)
                    canvas.drawPath(ui_custom_badge_path(points, float(size), float(size)), fill)
                if len(points) >= 2:
                    line = Paint()
                    line.setAntiAlias(True)
                    ui_set_paint_color(line, UI_PALETTE["primary"])
                    line.setStyle(Paint.Style.STROKE)
                    line.setStrokeWidth(float(ui_dp(3)))
                    line.setStrokeCap(Paint.Cap.ROUND)
                    line.setStrokeJoin(Paint.Join.ROUND)
                    if len(points) >= 3:
                        canvas.drawPath(ui_custom_badge_path(points, float(size), float(size)), line)
                    else:
                        path = Path()
                        path.moveTo(float(points[0][0] / 100.0 * size),
                                    float(points[0][1] / 100.0 * size))
                        for point in points[1:]:
                            path.lineTo(float(point[0] / 100.0 * size),
                                        float(point[1] / 100.0 * size))
                        canvas.drawPath(path, line)
                sketch.setImageBitmap(bmp)
                if int(preview_card.getVisibility()) == int(_View.VISIBLE):
                    update_profile_preview()
            except Exception as e:
                self._log("custom badge preview: %s" % e)

        redraw()
        sketch.setOnTouchListener(_BadgeSketchTouch(state, redraw))
        row = _LinearLayout(ctx)
        row.setOrientation(_LinearLayout.HORIZONTAL)
        clear_button = ui_outlined_btn(ctx, "Очистить", lambda v: (state["points"].clear(), redraw()))
        apply_button = ui_tonal_btn(ctx, "Применить",
                                    lambda v: self._ui_save_custom_badge(state["points"]))
        row.addView(clear_button, ui_lin(0, ui_dp(52), 1, (0, 0, 4, 0)))
        row.addView(apply_button, ui_lin(0, ui_dp(52), 1, (4, 0, 0, 0)))
        root.addView(row, ui_lin(-1, -2))
        self.ui_show_sheet(root, max_height=0.88, scroll_y=0)

    def _ui_badge_strip(self, ctx, current, on_pick):

        row = _LinearLayout(ctx)
        row.setOrientation(_LinearLayout.HORIZONTAL)
        hsv = _HSV(ctx)
        hsv.setOverScrollMode(_View.OVER_SCROLL_NEVER)
        hsv.addView(row)
        state = {"i": 0}
        LST = list(ui_SHAPE_LEVELS)
        custom_points = self._ui_custom_badge_points()
        if len(custom_points) >= 3:
            LST.append("custom")
        level = max(1, min(99, self._int_setting("rating_level", 10)))

        def add_batch():
            try:
                if state["i"] > 0 and not row.isAttachedToWindow():
                    return
                end = min(len(LST), state["i"] + 12)
                while state["i"] < end:
                    lv = LST[state["i"]]
                    cell = _FrameLayout(ctx)
                    custom_item = lv == "custom"
                    sel = current[0] == "custom" if custom_item else current[0] != "custom" and lv == int(current[0])
                    ui_set_bg(cell, ui_rounded(
                        UI_PALETTE["secondary_container"] if sel else UI_PALETTE["surface_container_high"], 14))
                    cell.setPadding(ui_dp(6), ui_dp(6), ui_dp(6), ui_dp(6))
                    if custom_item:
                        cell.addView(ui_make_custom_badge(
                            ctx, custom_points, 38, level,
                            UI_PALETTE["primary"] if sel else UI_PALETTE["on_surface_variant"],
                            UI_PALETTE["on_secondary_container"] if sel else UI_PALETTE["surface_container_highest"],
                            number=level),
                            ui_frm(ui_dp(38), ui_dp(38), _Gravity.TOP | _Gravity.CENTER_HORIZONTAL))
                        cell.addView(ui_text(ctx, "Своя", 11,
                                             UI_PALETTE["on_secondary_container"] if sel else UI_PALETTE["on_surface_variant"],
                                             sel, _Gravity.CENTER),
                                     ui_frm(-2, ui_dp(14), _Gravity.BOTTOM | _Gravity.CENTER_HORIZONTAL))
                    else:
                        cell.addView(ui_make_badge(
                            ctx, lv, 44,
                            UI_PALETTE["primary"] if sel else UI_PALETTE["on_surface_variant"],
                            UI_PALETTE["on_secondary_container"] if sel else UI_PALETTE["surface_container_highest"]),
                            ui_frm(-2, -2, _Gravity.CENTER))

                    def pick(v, lv=lv):
                        on_pick(lv)

                    ui_on_click(cell, pick)
                    if custom_item:
                        row.addView(cell, ui_lin(ui_dp(58), ui_dp(64), None, (3, 4, 3, 4)))
                    else:
                        row.addView(cell, ui_lin(-2, -2, None, (3, 4, 3, 4)))
                    state["i"] += 1
                if state["i"] < len(LST):
                    row.postDelayed(_uiRunner(add_batch), 30)
            except Exception as e:
                try:
                    self._log("ui badge strip: " + str(e))
                except Exception:
                    pass

        add_batch()
        return hsv

    def _ui_auto_stars(self, lv, e1=None, e2=None):

        lv = max(1, min(99, int(lv)))
        s = ui_level_stars(lv)
        n = ui_level_stars(min(100, lv + 1))
        if n <= s:
            n = s + 1

        s = s + (n - s) // 2
        self._ui_set("rating_stars", str(s))
        self._ui_set("rating_next", str(n))
        for e, v in ((e1, s), (e2, n)):
            try:
                if e is not None:
                    e.setText(str(v))
            except Exception:
                pass
        return s, n

    def _ui_build_rating(self, *args):
                                                                                
        prev_screen = getattr(self, "_ui_screen", "")
        alive = self.ui_sheet_alive()
        if alive and prev_screen == "home":
            try:
                self._ui_home_scroll_y = int(self._ui_sheet_sv.getScrollY())
            except Exception:
                self._ui_home_scroll_y = 0
            target_scroll = 0
        elif alive and prev_screen == "rating":
            try:
                target_scroll = int(self._ui_sheet_sv.getScrollY())
            except Exception:
                target_scroll = 0
        elif alive and prev_screen == "badge_drawer":
            target_scroll = max(0, int(getattr(self, "_ui_rating_scroll_y", 0)))
        else:
            target_scroll = 0
        self._ui_screen = "rating"
        ctx = self.ui_activity()
        lvl = max(1, min(99, self._int_setting("rating_level", 10)))
        shp = self._ui_shape()
        cur = ["custom" if self._bool("rating_custom_enabled", False) and
               len(self._ui_custom_badge_points()) >= 3 else shp]
        root = _LinearLayout(ctx)
        root.setOrientation(_LinearLayout.VERTICAL)
        root.setPadding(ui_dp(16), ui_dp(18), ui_dp(16), ui_dp(24))
        root.addView(self.ui_sheet_header(
            ctx, "Рейтинг", "Уровень и форма — отдельно",
            left=lambda v: self._ui_home()),
            ui_lin(-1, -2, None, (0, 0, 0, 14)))

        sw, _ = ui_switch_row(
            ctx, "Подмена рейтинга", "Показывать свой рейтинг",
            self._bool("custom_rating", False),
            lambda v: (self._ui_set("custom_rating", v), self._ui_repaint()))
        root.addView(sw, ui_lin(-1, -2, None, (0, 0, 0, 10)))
        swf, _ = ui_switch_row(
            ctx, "Форма по уровню", "Выключи — форма выбирается отдельно",
            self._bool("rating_shape_follow", True),
            lambda v: (self._ui_set("rating_shape_follow", v), self._ui_build_rating()))
        root.addView(swf, ui_lin(-1, -2, None, (0, 0, 0, 14)))

        card = _FrameLayout(ctx)
        ui_set_bg(card, ui_rounded(UI_PALETTE["surface_container_high"], 24))
        holder = _FrameLayout(ctx)
        card.addView(holder, ui_frm(-1, ui_dp(190), _Gravity.CENTER))
        root.addView(card, ui_lin(-1, -2, None, (0, 0, 0, 10)))

        def paint_badge():
            holder.removeAllViews()
            s = self._ui_shape()
            lv = max(1, min(99, self._int_setting("rating_level", 10)))
            custom_points = self._ui_custom_badge_points()
            if self._bool("rating_custom_enabled", False) and custom_points:
                b = ui_make_custom_badge(ctx, custom_points, 140, lv,
                                         UI_PALETTE["primary"], UI_PALETTE["on_primary"], number=lv)
            else:
                b = ui_make_badge(ctx, s, 140, UI_PALETTE["primary"], UI_PALETTE["on_primary"], number=lv)
            holder.addView(b, ui_frm(ui_dp(140), ui_dp(140), _Gravity.CENTER))
            lvl_tv.setText("Уровень: %d · Форма: %s" % (
                lv, "своя" if self._bool("rating_custom_enabled", False) and custom_points else str(s)))

        lvl_tv = ui_label(ctx, "")
        lvl_tv.setPadding(ui_dp(4), 0, 0, 0)
        root.addView(lvl_tv, ui_lin(-2, -2, None, (0, 8, 0, 4)))

        paint_badge()

        def on_slider(p):
            lv = self._ui_set_level(1 + int(p))
                                                                    
            self._ui_auto_stars(lv, _e, _e2)
            cur[0] = "custom" if self._bool("rating_custom_enabled", False) and \
                len(self._ui_custom_badge_points()) >= 3 else self._ui_shape()
            paint_badge()

        root.addView(ui_slider(ctx, 99, max(0, lvl - 1), on_slider),
                     ui_lin(-1, -2, None, (0, 0, 0, 10)))

        def on_pick(lv):
            if lv == "custom":
                if len(self._ui_custom_badge_points()) < 3:
                    self.ui_toast("Сначала нарисуй и примени свою форму")
                    return
                self._ui_set("rating_shape_follow", False)
                self._ui_set("rating_custom_enabled", True)
                self._ui_repaint()
                try:
                    self._post_user_info_did_load("ui-custom-shape")
                except Exception:
                    pass
                cur[0] = "custom"
                paint_badge()
                self._ui_build_rating()
                return
                                                             
            if self._bool("rating_shape_follow", True):
                self._ui_set("rating_shape_follow", False)
            self._ui_set_shape(lv)
            cur[0] = self._ui_shape()
            paint_badge()
            self._ui_build_rating()

        root.addView(self._ui_badge_strip(ctx, cur, on_pick),
                     ui_lin(-1, -2, None, (0, 0, 0, 12)))
        root.addView(ui_tonal_btn(ctx, "Нарисовать форму бейджа",
                                  lambda v: self._ui_build_badge_drawer()),
                     ui_lin(-1, -2, None, (0, 0, 0, 12)))

        f, _e = ui_field(ctx, "Звёзды (мин. для уровня)",
                          self._ui_get("rating_stars",
                                        str(ui_level_stars(lvl))),
                          lambda s: (self._ui_set("rating_stars", s), self._ui_repaint()),
                          numeric=True)
        root.addView(f, ui_lin(-1, -2, None, (0, 0, 0, 10)))
        f2, _e2 = ui_field(ctx, "Порог следующего уровня",
                            self._ui_get("rating_next",
                                          str(ui_level_stars(min(99, lvl + 1)))),
                            lambda s: (self._ui_set("rating_next", s), self._ui_repaint()),
                            numeric=True)
        root.addView(f2, ui_lin(-1, -2, None, (0, 0, 0, 10)))
        root.addView(ui_tonal_btn(ctx, "Пересчитать минимум для уровня",
                                      lambda v: self._ui_auto_stars(
                                          self._int_setting("rating_level", 10), _e, _e2)),
                     ui_lin(-1, -2, None, (0, 0, 0, 0)))
        self.ui_show_sheet(root, max_height=0.88, scroll_y=target_scroll)

        def _dump_diag(*_a):
            try:
                if _ui_BADGE_DIAG:
                    self._log("badge diag: " + " | ".join(_ui_BADGE_DIAG[:6]))
            except Exception:
                pass

        try:
            _run_ui(_dump_diag, 400)
            _run_ui(_dump_diag, 1200)
        except Exception:
            pass

    def _overlay_profile_badge(self, rating_view):

        try:
            now = time.time()
            if now - float(getattr(self, "_rv_info_ts", 0) or 0) > 10.0:
                self._rv_info_ts = now
                nm = "?"
                try:
                    nm = str(rating_view.getClass().getSimpleName())
                except Exception:
                    pass
                kids = -1
                try:
                    kids = int(rating_view.getChildCount or 0)
                except Exception:
                    pass
                w = h = 0
                try:
                    w = int(rating_view.getWidth() or 0)
                    h = int(rating_view.getHeight() or 0)
                except Exception:
                    pass
                self._log("ratingView info: %s kids=%d w=%d h=%d" % (nm, kids, w, h))
        except Exception:
            pass

    def _srv_native_colors(self, view):

        try:
            f = view.getClass().getDeclaredField("colors")
            f.setAccessible(True)
            c = f.get(view)
            if c is not None:
                bg = int(c.backgroundColor)
                fg = int(c.fillingColor)
                if (bg & 0xFF000000) != 0 and (fg & 0xFF000000) != 0:
                    return bg, fg
        except Exception:
            pass

        try:
            T = jclass("org.telegram.ui.ActionBar.Theme")
            dark = bool(T.isCurrentThemeDark())
        except Exception:
            dark = True
        if dark:
            return 0xFFFFFFFF, 0xFF212121
        return 0xFF1A1A1A, 0xFFF5F5F5

    def _srv_draw_badge(self, canvas, w, h):

        try:
            if not self._bool("custom_rating", False):
                return
            shp = self._ui_shape()
            lv = max(1, min(99, self._int_setting("rating_level", 10)))
            S = float(ui_dp(24))
            x0 = (float(w) - S) / 2.0
            y0 = (float(h) - S) / 2.0
            outer_c, inner_c = self._srv_native_colors(self._srv_last_view)
            paint = Paint()
            try:
                paint.setAntiAlias(True)
            except Exception:
                pass
            if not ui_set_paint_color(paint, inner_c):
                return
            custom_points = self._ui_custom_badge_points()
            if self._bool("rating_custom_enabled", False) and custom_points:
                path = ui_custom_badge_path(custom_points, S, S)
            else:
                path = ui_badge_smooth_path(shp, S, S)
            try:
                canvas.save()
            except Exception:
                pass
            canvas.translate(float(x0), float(y0))
                     
            canvas.drawPath(path, paint)
                                                        
            sp = Paint()
            try:
                sp.setAntiAlias(True)
            except Exception:
                pass
            if ui_set_paint_color(sp, outer_c):
                try:
                    sp.setStyle(Paint.Style.STROKE)
                except Exception:
                    try:
                        sp.setStyle(jclass("android.graphics.Paint$Style").STROKE)
                    except Exception:
                        sp = None
                if sp is not None:
                    try:
                        sp.setStrokeWidth(float(ui_dp(1.5)))
                    except Exception:
                        pass
                    canvas.drawPath(path, sp)
                   
            tp = Paint()
            try:
                tp.setAntiAlias(True)
            except Exception:
                pass
            if ui_set_paint_color(tp, outer_c):
                try:
                    tp.setTextAlign(Paint.Align.CENTER)
                except Exception:
                    try:
                        tp.setTextAlign(jclass("android.graphics.Paint$Align").CENTER)
                    except Exception:
                        pass
                try:
                    tp.setTextSize(S * 0.42)
                except Exception:
                    pass
                try:
                    tp.setTypeface(Typeface.create("sans-serif-condensed", Typeface.BOLD))
                except Exception:
                    pass
                try:
                    fm = tp.getFontMetrics()
                    cy = S / 2.0 - (fm.ascent + fm.descent) / 2.0
                    dy = BADGE_LABEL_DY[shp - 1] / 100.0 * S
                    canvas.drawText(str(lv), S / 2.0, cy + dy, tp)
                except Exception:
                    try:
                        canvas.drawText(str(lv), S / 2.0, S / 2.0, tp)
                    except Exception:
                        pass
            try:
                canvas.restore()
            except Exception:
                pass
        except Exception as e:
            try:
                now = time.time()
                if now - float(getattr(self, "_srv_draw_err_ts", 0) or 0) > 10.0:
                    self._srv_draw_err_ts = now
                    self._log("srv draw badge: %s" % e)
            except Exception:
                pass

    def _ui_set_tl_value(self, obj, name, value):
        if obj is None:
            return False
        try:
            setattr(obj, name, value)
            return True
        except Exception:
            pass
        try:
            cls = obj.getClass()
            while cls is not None:
                try:
                    field = cls.getDeclaredField(name)
                    field.setAccessible(True)
                    field.set(obj, value)
                    return True
                except Exception:
                    try:
                        cls = cls.getSuperclass()
                    except Exception:
                        break
        except Exception:
            pass
        return False

    def _ui_copy_tl_object(self, source):
        if source is None:
            return None
        try:
            cls = source.getClass()
            target = _new_instance(cls)
            if target is None:
                return None
            current = cls
            while current is not None:
                try:
                    fields = current.getDeclaredFields()
                except Exception:
                    fields = []
                for field in fields:
                    try:
                        if int(field.getModifiers()) & 8:
                            continue
                        field.setAccessible(True)
                        field.set(target, field.get(source))
                    except Exception:
                        pass
                try:
                    current = current.getSuperclass()
                except Exception:
                    current = None
            return target
        except Exception:
            return None

    def _ui_prepare_local_unique_gift(self, source, profile_dialog_id, account):
        did = int(profile_dialog_id or 0)
        if source is None or did < 1000:
            return None
        gift = self._ui_copy_tl_object(source)
        if gift is None:
            return None
        peer = self._peer(did)
        if peer is None:
            return None
        values = (
            ("owner_id", peer),
            ("owner_name", None),
            ("owner_address", None),
            ("gift_address", None),
            ("host_id", None),
            ("resell_amount", None),
            ("resale_ton_only", False),
            ("offer_min_stars", 0),
        )
        for name, value in values:
            if not self._ui_set_tl_value(gift, name, value):
                if name in ("owner_id", "resell_amount"):
                    return None
        seed_text = "%s:%s:%d" % (
            str(getattr(gift, "slug", "") or ""),
            str(getattr(gift, "gift_id", "") or ""),
            did,
        )
        seed = sum((index + 1) * ord(char) for index, char in enumerate(seed_text))
        try:
            total = int(getattr(gift, "availability_total", 0) or 0)
        except Exception:
            total = 0
        if total <= 0 or total > 99999:
            total = 1000 + seed % 9000
        try:
            issued = int(getattr(gift, "availability_issued", 0) or 0)
        except Exception:
            issued = 0
        if issued <= 0 or issued > total or issued > 99999:
            if total >= 1000:
                issued = 100 + (seed // 7) % 900
            elif total >= 100:
                issued = 100 + (seed // 7) % (total - 99)
            else:
                issued = 1 + (seed // 7) % max(1, total)
        try:
            number = int(getattr(gift, "num", 0) or 0)
        except Exception:
            number = 0
        if number <= 0 or number > issued or number > 99999:
            digits = len(str(max(1, issued)))
            low = 10 ** (digits - 1) if digits > 1 else 1
            high = min(issued, (10 ** digits) - 1, 99999)
            if high < low:
                low = 1
                high = max(1, min(issued, 99999))
            number = low + (seed // 13) % max(1, high - low + 1)
        for name, value in (
            ("num", number),
            ("availability_issued", issued),
            ("availability_total", total),
        ):
            if not self._ui_set_tl_value(gift, name, int(value)):
                return None
        flags = int(getattr(gift, "flags", 0) or 0)
        flags &= ~((1 << 1) | (1 << 2) | (1 << 3) | (1 << 4) | (1 << 7) | (1 << 12) | (1 << 13))
        flags |= (1 << 0) | (1 << 30)
        if not self._ui_set_tl_value(gift, "flags", flags):
            return None
        return gift

    def _ui_find_visual_gift(self, slug):
        target = str(slug or "").strip().lower()
        if not target:
            return None
        matches = []
        try:
            for did, bucket in self._local_profile_gifts.items():
                for meta in (bucket or {}).values():
                    gift = meta.get("gift")
                    current = str(getattr(gift, "slug", "") or "").strip().lower()
                    if current == target:
                        item = dict(meta)
                        item["profile_dialog_id"] = int(did)
                        matches.append(item)
        except Exception:
            pass
        if not matches:
            return None
        return max(matches, key=lambda item: float(item.get("ts", 0) or 0))

    def _ui_build_unique_response(self, meta):
        if not isinstance(meta, dict):
            return None
        source = meta.get("gift")
        did = int(meta.get("profile_dialog_id", 0) or 0)
        if source is None or did < 1000:
            return None
        account = int(UserConfig.selectedAccount)
        gift = self._ui_prepare_local_unique_gift(source, did, account)
        if gift is None:
            return None
        owner = None
        try:
            owner = MessagesController.getInstance(account).getUser(did)
        except Exception:
            pass
        Response = None
        for name in (
            "org.telegram.tgnet.tl.TL_stars$TL_payments_uniqueStarGift",
            "org.telegram.tgnet.TLRPC$TL_payments_uniqueStarGift",
            "org.telegram.tgnet.TL_stars$TL_payments_uniqueStarGift",
        ):
            Response = _cls(name)
            if Response is not None:
                break
        if Response is None:
            self._log("visual collectible response class not found")
            return None
        response = _new_instance(Response)
        if response is None or not self._ui_set_tl_value(response, "gift", gift):
            return None
        self._ui_set_tl_value(response, "chats", ArrayList())
        users = ArrayList()
        if owner is not None:
            users.add(owner)
        self._ui_set_tl_value(response, "users", users)
        return response

    def _hook_resale_answers(self):

        if getattr(self, "_resale_hook_done", False):
            return
        plugin = self

        class ResaleHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    req = param.args[0] if param.args else None
                    if req is None:
                        return
                    name = str(req.getClass().getSimpleName()).lower()
                    if not name.endswith("getuniquestargift"):
                        return
                    slug = str(getattr(req, "slug", "") or "")
                    meta = plugin._ui_find_visual_gift(slug)
                    plugin._log("unique gift detail request slug=%s local=%s" % (slug, meta is not None))
                    if meta is None:
                        return
                    idx, delegate = None, None
                    for i, a in enumerate(list(param.args)):
                        if i > 0 and a is not None and hasattr(a, "run"):
                            idx, delegate = i, a
                            break
                    if delegate is None or idx is None:
                        return
                    resp = plugin._ui_build_unique_response(meta)
                    if resp is None:
                        return
                    _run_ui(lambda: delegate.run(resp, None))
                    param.setResult(0)
                    plugin._log("visual collectible answered locally: " + slug)
                except Exception as e:
                    try:
                        plugin._log("ui resale hook: " + str(e))
                    except Exception:
                        pass

        for cn in ("org.telegram.tgnet.ConnectionsManager",
                   "org.telegram.messenger.ConnectionsManager"):
            try:
                c = _cls(cn)
                if c is None:
                    continue
                refs = self.hook_all_methods(c, "sendRequest", ResaleHook())
                if refs:
                    self._hooks.extend(refs if isinstance(refs, list) else [refs])
                    self._resale_hook_done = True
                    self._log("unique gift deep-link hook installed: " + cn)
                    return
            except Exception as e:
                self._log("ui resale hook attach: " + str(e))
        if not self._resale_hook_done:
            self._log("unique gift deep-link hook not attached")

    def _hook_local_gift_sheet(self):
        if getattr(self, "_local_gift_sheet_hook_done", False):
            return
        Sheet = _cls("org.telegram.ui.Stars.StarGiftSheet")
        if Sheet is None:
            self._log("local gift sheet class not found")
            return
        plugin = self

        class LocalGiftSheetHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    args = param.args or []
                    if not args or args[0] is None:
                        return
                    message = args[0]
                    try:
                        message_class = str(message.getClass().getSimpleName()).lower()
                    except Exception:
                        return
                    if "messageobject" not in message_class:
                        return
                    owner = getattr(message, "messageOwner", None)
                    action = getattr(owner, "action", None) if owner is not None else None
                    gift = getattr(action, "gift", None) if action is not None else None
                    if gift is None or not (int(getattr(gift, "flags", 0) or 0) & (1 << 30)):
                        return
                    sheet = param.thisObject
                    if not plugin._ui_set_tl_value(sheet, "messageObjectRepolled", True):
                        plugin._log("local gift quantity repoll flag unavailable")
                        return
                    plugin._ui_set_tl_value(sheet, "messageObjectRepolling", False)
                    plugin._log("local gift quantity ready num=%s issued=%s total=%s" % (
                        getattr(gift, "num", 0),
                        getattr(gift, "availability_issued", 0),
                        getattr(gift, "availability_total", 0),
                    ))
                except Exception as e:
                    plugin._log("local gift sheet hook: " + str(e))

        try:
            refs = self.hook_all_methods(Sheet, "set", LocalGiftSheetHook())
            if refs:
                self._hooks.extend(refs if isinstance(refs, list) else [refs])
                self._local_gift_sheet_hook_done = True
                self._log("local gift quantity hook installed: org.telegram.ui.Stars.StarGiftSheet.set")
            else:
                self._log("local gift quantity hook returned no methods")
        except Exception as e:
            self._log("local gift quantity hook attach: " + str(e))

    def _hook_resale_equivalency(self):
        try:
            if getattr(self, "_resale_equivalency_hook_done", False):
                return
            sheet_cls = _cls("org.telegram.ui.Stars.StarGiftSheet")
            if sheet_cls is None:
                return
            plugin = self

            class ResaleEquivalencyHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        args = param.args or []
                        gift = args[0] if len(args) > 0 else None
                        ton_only = plugin._visual_read_member(gift, "resale_ton_only")
                        if not bool(ton_only):
                            return
                        button = plugin._visual_read_member(param.thisObject, "button")
                        if button is None:
                            return
                        try:
                            button.setSubText(None, False)
                        except Exception:
                            button.setSubText(None, True)
                    except Exception as e:
                        plugin._log("resale TON subtext hook: " + str(e))

            refs = self.hook_all_methods(sheet_cls, "setButtonTextResale", ResaleEquivalencyHook())
            if refs:
                self._hooks.extend(refs if isinstance(refs, list) else [refs])
                self._resale_equivalency_hook_done = True
                self._log("resale TON-equivalency text hook installed")
        except Exception as e:
            self._log("resale TON-equivalency hook failed: " + str(e))

    def _log(self, msg, force=False):
        try:
            line = "[%s] %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), str(msg))
            if not hasattr(self, "_log_buf"):
                self._log_buf = []
            self._log_buf.append(line)
            if len(self._log_buf) > 400:
                self._log_buf = self._log_buf[-250:]
            try:
                self.log(str(msg))
            except Exception:
                pass
        except Exception:
            pass

    def _log_filename(self):
        try:
            ver = str(__version__).replace(" ", "_")
        except Exception:
            ver = "unknown"
        return "richnft_v%s_debug.log" % ver

    def _log_path(self):
        name = self._log_filename()
        try:
            env = jclass("android.os.Environment")
            dl = env.getExternalStoragePublicDirectory(env.DIRECTORY_DOWNLOADS)
            if dl is not None:
                f = jclass("java.io.File")(dl, name)
                return str(f.getAbsolutePath())
        except Exception:
            pass
        for base in (
            "/storage/emulated/0/Download",
            "/sdcard/Download",
            "/storage/emulated/0/Downloads",
        ):
            return "%s/%s" % (base, name)
        try:
            ctx = ApplicationLoader.applicationContext
            d = ctx.getFilesDir()
            f = jclass("java.io.File")(d, name)
            return str(f.getAbsolutePath())
        except Exception:
            return "/storage/emulated/0/Download/%s" % name

    def _read_logs(self, max_lines=200):
        out = []
        try:
            if hasattr(self, "_log_buf") and self._log_buf:
                out.extend(self._log_buf[-max_lines:])
        except Exception:
            pass
        return out

    def _share_logs_click(self, *args, **kwargs):
        try:
            lines = self._read_logs(250)
            text = "\n".join(lines) if lines else "(пусто — включи «Подробные логи» и воспроизведи баг)"
            text = "RichNft v%s logs\n%s\n%s" % (
                str(__version__),
                self._log_path() or "буфер",
                text,
            )
            try:
                ctx = ApplicationLoader.applicationContext
                intent = jclass("android.content.Intent")(jclass("android.content.Intent").ACTION_SEND)
                intent.setType("text/plain")
                intent.putExtra(jclass("android.content.Intent").EXTRA_TEXT, text)
                chooser = jclass("android.content.Intent").createChooser(intent, "Отправить логи")
                chooser.addFlags(jclass("android.content.Intent").FLAG_ACTIVITY_NEW_TASK)
                ctx.startActivity(chooser)
                BulletinHelper.show_info("Логи отправлены")
            except Exception as e:
                try:
                    from android_utils import copy_to_clipboard
                    copy_to_clipboard(text)
                    BulletinHelper.show_info("Логи скопированы в буфер")
                except Exception:
                    cm = ctx.getSystemService(ctx.CLIPBOARD_SERVICE)
                    clip = jclass("android.content.ClipData").newPlainText("richnft_logs", text)
                    cm.setPrimaryClip(clip)
                    BulletinHelper.show_info("Логи скопированы в буфер")
            self._log("logs shared, lines=%d" % len(lines), force=True)
        except Exception as e:
            self._log("share logs err: %s" % e, force=True)
            try:
                BulletinHelper.show_info("Ошибка отправки логов")
            except:
                pass

    def _clear_logs_click(self, *args, **kwargs):
        try:
            self._log_buf = []
            path = self._log_path()
            if path:
                try:
                    f = jclass("java.io.File")(path)
                    if f.exists():
                        f.delete()
                except:
                    pass
            try:
                BulletinHelper.show_info("Логи очищены")
            except Exception:
                pass
        except Exception as e:
            self._log("clear logs err: %s" % e, force=True)

def create_plugin():
    return RichNftPlugin()

def get_plugin():
    return RichNftPlugin()
