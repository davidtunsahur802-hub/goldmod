            lambda v: self._ui_set("show_gift_tabs", v))
        card.addView(sw, ui_lin(-1, -2, None, (0, 4, 0, 6)))
        root.addView(sec, ui_lin(-1, -2, None, (0, 0, 0, 16)))

        sec, card = ui_section(ctx, "Баланс")
        sw, _ = ui_switch_row(
