def _cls(name):
    try:
        c = find_class(name)
        if c is not None:
            return c
    except Exception:
        pass
    try:
        return jclass(name)
    except Exception:
        return None

def _run_ui(fn, delay=0):
    try:
        r = dynamic_proxy(jclass("java.lang.Runnable"))(type("R", (), {"run": lambda s: fn()})())
        if delay > 0:
            AndroidUtilities.runOnUIThread(r, delay)
        else:
            AndroidUtilities.runOnUIThread(r)
    except Exception:
        try:
            run_on_ui_thread(fn)
        except Exception:
            pass

def _find_method(cls, name, param_count=None):
    if cls is None:
        return None
    try:
        for m in cls.getDeclaredMethods():
            if m.getName() == name:
                if param_count is None or len(m.getParameterTypes()) == param_count:
                    m.setAccessible(True)
                    return m
        for m in cls.getMethods():
            if m.getName() == name:
                if param_count is None or len(m.getParameterTypes()) == param_count:
                    return m
    except Exception:
        pass
    return None

def _find_field(obj_or_cls, name):
    try:
        cls = obj_or_cls if hasattr(obj_or_cls, "getDeclaredFields") else obj_or_cls.getClass()
    except Exception:
        cls = None
    if cls is None:
        return None
    try:
        for c in (cls,):
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return f
            except Exception:
                pass
            try:
                f = c.getField(name)
                f.setAccessible(True)
                return f
            except Exception:
                pass
    except Exception:
        pass
    return None

def _new_instance(cls):
    
    if cls is None:
        return None
    try:
        return cls()
    except Exception:
        pass
    try:
        ctor = cls.getDeclaredConstructor()
        ctor.setAccessible(True)
        return ctor.newInstance()
    except Exception:
        pass
    try:
        return cls.newInstance()
    except Exception:
        pass
    return None

def _is_gift(obj):
    if obj is None:
        return False
    try:
        n = str(obj.getClass().getName())
    except Exception:
        return False
    for b in ("Action", "Sheet", "Controller", "Fragment", "Message", "GiftSheet", "Saved"):
        if b in n and "TL_starGift" not in n and "StarGift" not in n:
            return False
    for g in ("TL_starGift", "TL_stars$TL_starGift", "tl.TL_stars$StarGift",
              "tl.TL_stars$TL_starGift", "$StarGift", "StarGiftUnique"):
        if g in n:
            return True
    try:
        sn = obj.getClass().getSimpleName()
        if sn in ("TL_starGift", "TL_starGiftUnique", "StarGift", "StarGiftUnique"):
            return True
        if sn.startswith("TL_starGift"):
            return True
    except Exception:
        pass
    return False

def _is_unique(gift):
    if gift is None:
        return False
    try:
        if "unique" in gift.getClass().getSimpleName().lower():
            return True
    except Exception:
        pass
    try:
        if "unique" in str(gift.getClass().getName()).lower():
            return True
    except Exception:
        pass
    for attr in ("slug", "num", "attributes"):
        try:
            v = getattr(gift, attr, None)
            if attr == "slug" and v and str(v).strip():
                return True
            if attr == "num" and v is not None and int(v) > 0:
                return True
            if attr == "attributes" and v is not None and hasattr(v, "size") and int(v.size()) > 0:
                return True
        except Exception:
            pass
    return False

def _extract_gift(obj):
    if obj is None:
        return None
    if _is_gift(obj):
        return obj
    for fname in ("starGift", "gift", "selectedGift", "currentGift", "mGift",
                  "uniqueGift", "giftUnique", "toGift", "resaleGift", "savedGift"):
        try:
            g = getattr(obj, fname, None)
            if g is None:
                continue
            if _is_gift(g):
                return g
            try:
                inner = getattr(g, "gift", None)
                if _is_gift(inner):
                    return inner
            except Exception:
                pass
        except Exception:
            pass
    try:
        cls = obj.getClass()
        for _ in range(6):
            if cls is None or str(cls.getName()) == "java.lang.Object":
                break
            try:
                for f in cls.getDeclaredFields():
                    try:
                        f.setAccessible(True)
                        val = f.get(obj)
                        if _is_gift(val):
                            return val
                    except Exception:
                        continue
            except Exception:
                pass
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
    except Exception:
        pass
    return None

def _bad_text(s):
    if not s:
        return True
    low = s.lower().strip()
    if len(low) < 1 or (low.isdigit() and len(low) <= 4):
        return True
    for b in _BAD_MSG:
        if b in low:
            return True
    return False

def _extract_message(sheet):
    if sheet is None:
        return " "
    obj = None
    try:
        cls = sheet.getClass()
        for _ in range(8):
            if cls is None or str(cls.getName()) == "java.lang.Object":
                break
            for getter in ("getDeclaredMethod", "getMethod"):
                try:
                    m = getattr(cls, getter)("getMessage")
                    m.setAccessible(True)
                    obj = m.invoke(sheet)
                    if obj is not None:
                        break
                except Exception:
                    pass
            if obj is not None:
                break
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
    except Exception:
        pass
    if obj is None:
        try:
            action = getattr(sheet, "action", None)
            if action is not None:
                obj = getattr(action, "message", None)
        except Exception:
            pass
    if obj is None:
        try:
            obj = getattr(sheet, "message", None)
        except Exception:
            pass
    if obj is None:
        return " "
    try:
        t = getattr(obj, "text", None)
        if t is not None:
            s = str(t).strip()
            if s and not _bad_text(s):
                return s
    except Exception:
        pass
    try:
        s = str(obj).strip()
        if s and not s.startswith("org.telegram") and "Object@" not in s and not _bad_text(s) and len(s) < 500:
            return s
    except Exception:
        pass
    return " "

def _extract_anonymous(obj):
    if obj is None:
        return False
    for fname in ("anonymous", "isAnonymous", "anon", "hideSender", "senderHidden", "nameHidden"):
        try:
            v = getattr(obj, fname, None)
            if v is not None:
                return bool(v)
        except Exception:
            pass
    for mname in ("isAnonymous", "getAnonymous", "isHideSender", "isNameHidden"):
        try:
            m = obj.getClass().getDeclaredMethod(mname)
            m.setAccessible(True)
            return bool(m.invoke(obj))
        except Exception:
            pass
    return False

def _extract_dialog_id(obj):
    if obj is None:
        return 0
    for fname in (
        "dialogId", "dialog_id", "currentDialogId", "selectedDialogId",
        "userId", "user_id", "chatId", "chat_id", "to_id", "toId",
        "mDialogId",
    ):
        try:
            v = getattr(obj, fname, None)
            if v is None:
                continue
            try:
                uid = getattr(v, "user_id", None)
                if uid is not None and abs(int(uid)) > 1000:
                    return int(uid)
            except Exception:
                pass
            try:
                cid = getattr(v, "chat_id", None)
                if cid is not None and abs(int(cid)) > 1000:
                    return -abs(int(cid))
            except Exception:
                pass
            try:
                iv = int(v)
                if abs(iv) > 1000:
                    return iv
            except Exception:
                pass
        except Exception:
            pass
    for mname in ("getDialogId", "getPeerId", "getUserId", "getChatId", "getId"):
        try:
            m = obj.getClass().getMethod(mname)
            m.setAccessible(True)
            res = m.invoke(obj)
            if res is None:
                continue
            try:
                uid = getattr(res, "user_id", None)
                if uid is not None and abs(int(uid)) > 1000:
                    return int(uid)
            except Exception:
                pass
            try:
                iv = int(res)
                if abs(iv) > 1000:
                    return iv
            except Exception:
                pass
        except Exception:
            pass
    try:
        cls = obj.getClass()
        for _ in range(5):
            if cls is None or str(cls.getName()) == "java.lang.Object":
                break
            for f in cls.getDeclaredFields():
                try:
                    t = str(f.getType().getName())
                    if t not in ("long", "java.lang.Long", "int", "java.lang.Integer"):
                        continue
                    name = f.getName().lower()
                    if not any(k in name for k in ("dialog", "user", "chat", "peer", "to_id", "toid")):
                        continue
                    f.setAccessible(True)
                    v = f.get(obj)
                    if v is None:
                        continue
                    iv = int(v)
                    if abs(iv) > 1000:
                        return iv
                except Exception:
                    continue
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
    except Exception:
        pass
    return 0

def _remember_dialog(did):
    global _pending_dialog, _pending_dialog_ts
    try:
        did = int(did or 0)
        if abs(did) > 1000:
            _pending_dialog = did
            _pending_dialog_ts = time.time()
    except Exception:
        pass

def _get_pending():
    try:
        if abs(_pending_dialog) > 1000 and (time.time() - _pending_dialog_ts) < 180:
            return _pending_dialog
    except Exception:
        pass
    return 0

def _dismiss_sheet(sheet):
    def _do():
        try:
            if sheet is not None:
                for m in ("dismiss", "lambdaDismiss", "finish", "closeParentSheet",
                          "onDismiss", "dismissInternal", "cancel"):
                    try:
                        fn = getattr(sheet, m, None)
                        if callable(fn):
                            fn()
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            la = _cls(LAUNCH_ACTIVITY)
            inst = getattr(la, "instance", None) if la else None
            if inst is not None:
                for _ in range(6):
                    try:
                        d = getattr(inst, "visibleDialog", None)
                        if d is not None and callable(getattr(d, "dismiss", None)):
                            d.dismiss()
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            frag = get_last_fragment()
            if frag is not None:
                for _ in range(6):
                    try:
                        d = getattr(frag, "visibleDialog", None)
                        if d is not None and callable(getattr(d, "dismiss", None)):
                            d.dismiss()
                    except Exception:
                        pass
        except Exception:
            pass
    _run_ui(_do, 0)
    _run_ui(_do, 40)
    _run_ui(_do, 100)

def _return_to_chat(dialog_id):
    try:
        dialog_id = int(dialog_id or 0)
    except Exception:
        return
    if abs(dialog_id) <= 1000:
        return
    def _do_return():
        try:
            la = _cls(LAUNCH_ACTIVITY)
            inst = getattr(la, "instance", None) if la else None
            if inst is None:
                return
            for _ in range(8):
                try:
                    d = getattr(inst, "visibleDialog", None)
                    if d is not None and callable(getattr(d, "dismiss", None)):
                        d.dismiss()
                except Exception:
                    pass
            try:
                frag = get_last_fragment()
                for _ in range(10):
                    if frag is None:
                        break
                    name = ""
                    try:
                        name = str(frag.getClass().getName())
                    except Exception:
                        break
                    if any(x in name for x in (
                        "Gift", "Stars", "Sheet", "Profile", "Market",
                        "StarGift", "SendGift", "BottomSheet"
                    )):
                        try:
                            if callable(getattr(frag, "finishFragment", None)):
                                frag.finishFragment()
                        except Exception:
                            pass
                        try:
                            if callable(getattr(frag, "finish", None)):
                                frag.finish()
                        except Exception:
                            pass
                        try:
                            frag = get_last_fragment()
                        except Exception:
                            break
                    else:
                        break
            except Exception:
                pass
            for _ in range(4):
                try:
                    d = getattr(inst, "visibleDialog", None)
                    if d is not None and callable(getattr(d, "dismiss", None)):
                        d.dismiss()
                except Exception:
                    pass
            try:
                ChatAct = _cls("org.telegram.ui.ChatActivity")
                if ChatAct is None:
                    return
                bundle_cls = _cls("android.os.Bundle")
                if bundle_cls is None:
                    return
                bundle = bundle_cls()
                if dialog_id > 0:
                    bundle.putLong("user_id", int(dialog_id))
                else:
                    bundle.putLong("chat_id", abs(int(dialog_id)))
                chat_frag = ChatAct(bundle)
                if callable(getattr(inst, "presentFragment", None)):
                    try:
                        inst.presentFragment(chat_frag, True, True)
                    except Exception:
                        try:
                            inst.presentFragment(chat_frag, True)
                        except Exception:
                            try:
                                inst.presentFragment(chat_frag)
                            except Exception:
                                pass
            except Exception:
                pass
        except Exception:
            pass
    _run_ui(_do_return, 60)
    _run_ui(_do_return, 180)
    _run_ui(_do_return, 320)

import math as _math

from android.graphics import Typeface
from android.graphics.drawable import (
    GradientDrawable, LayerDrawable, ClipDrawable, Drawable,
)
from android.view import Gravity as _Gravity, View as _View
from android.widget import (
    FrameLayout as _FrameLayout, LinearLayout as _LinearLayout,
    TextView as _TextView, EditText as _EditText, ScrollView as _ScrollView,
    SeekBar as _SeekBar,
)
from android.text import InputType as _InputType
from android.animation import ValueAnimator as _ValueAnimator
from android.view.animation import (
    PathInterpolator as _PathInterpolator, DecelerateInterpolator as _Decel,
    OvershootInterpolator as _Over,
)

try:
    from android.graphics.drawable import RippleDrawable as _RippleDrawable
except Exception:
    _RippleDrawable = None
try:
    from android.content.res import ColorStateList as _ColorStateList
except Exception:
    _ColorStateList = None

_M3_DENS = [None]

UI_PALETTE = {
    "primary": 0xFFD0BCFF,
    "on_primary": 0xFF381E72,
    "primary_container": 0xFF4F378B,
    "on_primary_container": 0xFFEADDFF,
    "secondary_container": 0xFF4A4458,
    "on_secondary_container": 0xFFE8DEF8,
    "error": 0xFFF2B8B5,
    "surface": 0xFF141218,
    "surface_container": 0xFF211F26,
    "surface_container_high": 0xFF2B2930,
    "surface_container_highest": 0xFF36343B,
    "on_surface": 0xFFE6E1E5,
    "on_surface_variant": 0xFFCAC4D0,
    "outline": 0xFF938F99,
    "outline_variant": 0xFF49454F,
}

def ui_dp(v):
    if _M3_DENS[0] is None:
        try:
            _M3_DENS[0] = float(AndroidUtilities.density)
        except Exception:
            _M3_DENS[0] = 2.75
    return int(_math.ceil(_M3_DENS[0] * float(v)))

def ui_signed(c):
    c = int(c)
    return c - (1 << 32) if c >= (1 << 31) else c

def ui_c(name):
    return ui_signed(UI_PALETTE.get(name, UI_PALETTE["on_surface"]))

def ui_argb(a, r, g, b):
    return ui_signed((int(a) << 24) | (int(r) << 16) | (int(g) << 8) | int(b))

def ui_mix(a, b, t):
    return a + (b - a) * max(0.0, min(1.0, t))

def ui_rounded(color, radius_dp, radii=None):
    g = GradientDrawable()
    g.setColor(ui_signed(color))
    if radii is not None:
        from java import jarray, jfloat
        g.setCornerRadii(jarray(jfloat)([float(x) for x in radii]))
    else:
        g.setCornerRadius(float(ui_dp(radius_dp)))
    return g

def ui_set_bg(view, drawable):
    try:
        l, t, r, b = view.getPaddingLeft(), view.getPaddingTop(), \
            view.getPaddingRight(), view.getPaddingBottom()
        view.setBackground(drawable)
        view.setPadding(l, t, r, b)
    except Exception:
        try:
            view.setBackground(drawable)
        except Exception:
            pass

def ui_ripple(color, radius_dp, radii=None):
                                                                    
    content = ui_rounded(color, radius_dp, radii)
    if _RippleDrawable is None or _ColorStateList is None:
        return content
    try:
        mask = GradientDrawable()
        mask.setShape(GradientDrawable.RECTANGLE)
        if radii is not None:
            from java import jarray, jfloat
            mask.setCornerRadii(jarray(jfloat)([float(x) for x in radii]))
        else:
            mask.setCornerRadius(float(ui_dp(radius_dp)))
        mask.setColor(ui_signed(0xFFFFFFFF))
        csl = _ColorStateList.valueOf(ui_signed(0x33D0BCFF))
        return _RippleDrawable(csl, content, mask)
    except Exception:
        return content

def ui_lin(w=-2, h=-2, wt=None, m=(0, 0, 0, 0)):
    p = _LinearLayout.LayoutParams(w, h) if wt is None \
        else _LinearLayout.LayoutParams(w, h, float(wt))
    p.setMargins(ui_dp(m[0]), ui_dp(m[1]), ui_dp(m[2]), ui_dp(m[3]))
    return p

def ui_frm(w=-2, h=-2, gravity=None, m=(0, 0, 0, 0)):
    p = _FrameLayout.LayoutParams(w, h) if gravity is None \
        else _FrameLayout.LayoutParams(w, h, gravity)
    p.setMargins(ui_dp(m[0]), ui_dp(m[1]), ui_dp(m[2]), ui_dp(m[3]))
    return p

def ui_text(ctx, text, size, color, bold=False, gravity=None):
    t = _TextView(ctx)
    t.setTextSize(float(size))
    t.setTextColor(ui_signed(color))
    if bold:
        t.setTypeface(Typeface.DEFAULT_BOLD)
    if gravity is not None:
        t.setGravity(gravity)
    try:
        t.setIncludeFontPadding(False)
    except Exception:
        pass
    t.setText(str(text))
    return t

def ui_body(ctx, text, size, color, bold=False, gravity=None):
    t = ui_text(ctx, text, size, color, bold, gravity)
    t.setLineSpacing(ui_dp(2), 1.0)
    return t

def ui_headline(ctx, text):
    return ui_text(ctx, text, 24, UI_PALETTE["on_surface"], True)

def ui_label(ctx, text):
    return ui_text(ctx, text, 14, UI_PALETTE["primary"], True)

def ui_support(ctx, text):
    return ui_text(ctx, text, 13, UI_PALETTE["on_surface_variant"])

def ui_emph_dec():
                                                              
    try:
        return _PathInterpolator(0.05, 0.7, 0.1, 1.0)
    except Exception:
        return _Decel(2.0)

def ui_emph_acc():
                                                              
    try:
        return _PathInterpolator(0.3, 0.0, 0.8, 0.15)
    except Exception:
        return _Decel(1.4)

def ui_std():
                                                             
    try:
        return _PathInterpolator(0.2, 0.0, 0.0, 1.0)
    except Exception:
        return _Decel(1.6)

class _uiAnimUpdate(dynamic_proxy(jclass("android.animation.ValueAnimator$AnimatorUpdateListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onAnimationUpdate(self, anim):
        try:
            self.fn(float(anim.getAnimatedFraction()))
        except Exception:
            pass

class _uiClick(dynamic_proxy(_View.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        try:
            self.fn(v)
        except Exception as e:
            try:
                from android_utils import log
                log("richnft ui click: " + str(e))
            except Exception:
                pass

class _uiTouch(dynamic_proxy(_View.OnTouchListener)):

    def onTouch(self, v, e):
        try:
            a = int(e.getActionMasked())
            if a == 0:
                v.animate().cancel()
                v.animate().setStartDelay(0).scaleX(0.98).scaleY(0.98) \
                    .setDuration(100).setInterpolator(ui_std()).start()
            elif a == 1 or a == 3:
                v.animate().setStartDelay(0).scaleX(1.0).scaleY(1.0) \
                    .setDuration(200).setInterpolator(ui_emph_dec()).start()
        except Exception:
            pass
        return False

class _BadgeSketchTouch(dynamic_proxy(_View.OnTouchListener)):
    def __init__(self, state, on_change):
        super().__init__()
        self.state = state
        self.on_change = on_change

    def onTouch(self, view, event):
        try:
            action = int(event.getActionMasked())
            width = max(1.0, float(view.getWidth()))
            height = max(1.0, float(view.getHeight()))
            px = max(0.0, min(width, float(event.getX())))
            py = max(0.0, min(height, float(event.getY())))
            radius = min(float(ui_dp(24)), width * 0.5, height * 0.5)
            corner = None
            if px < radius and py < radius:
                corner = (radius, radius)
            elif px > width - radius and py < radius:
                corner = (width - radius, radius)
            elif px < radius and py > height - radius:
                corner = (radius, height - radius)
            elif px > width - radius and py > height - radius:
                corner = (width - radius, height - radius)
            if corner is not None:
                dx, dy = px - corner[0], py - corner[1]
                distance = _math.hypot(dx, dy)
                if distance > radius and distance > 0.001:
                    px = corner[0] + dx * radius / distance
                    py = corner[1] + dy * radius / distance
            x = max(1.0, min(99.0, px / width * 100.0))
            y = max(1.0, min(99.0, py / height * 100.0))
            points = self.state["points"]
            if action == 0:
                points[:] = [(x, y)]
            elif action == 1 or action == 2:
                if not points or _math.hypot(points[-1][0] - x, points[-1][1] - y) >= 0.8:
                    if len(points) < 180:
                        points.append((x, y))
                    else:
                        points[-1] = (x, y)
            elif action == 3:
                self.on_change()
                return True
            self.on_change()
            return True
        except Exception:
            return True

_ui_TOUCH = []
_ui_PRESS_ON = True

def ui_on_click(view, fn, press=None):
    view.setOnClickListener(_uiClick(fn))
    if (press if press is not None else _ui_PRESS_ON):
        try:
            if not _ui_TOUCH:
                _ui_TOUCH.append(_uiTouch())
            view.setOnTouchListener(_ui_TOUCH[0])
        except Exception:
            pass

class _uiRunner(dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.fn()
        except Exception:
            pass

class _uiDismissL(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onDismiss(self, dialog):
        try:
            self.fn()
        except Exception:
            pass

class _uiSeek(dynamic_proxy(_SeekBar.OnSeekBarChangeListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onProgressChanged(self, sb, progress, from_user):
        try:
            if from_user:
                self.fn(int(progress))
        except Exception:
            pass

    def onStartTrackingTouch(self, sb):
        pass

    def onStopTrackingTouch(self, sb):
        pass

class _uiDrag(dynamic_proxy(_View.OnTouchListener)):

    def __init__(self, plugin, wrap):
        super().__init__()
        self.plugin = plugin
        self.wrap = wrap
        self.y0 = 0.0

    def onTouch(self, v, e):
        try:
            a = int(e.getActionMasked())
            if a == 0:
                self.wrap.animate().cancel()
                self.y0 = float(e.getRawY()) - float(self.wrap.getTranslationY())
            elif a == 2:
                self.wrap.setTranslationY(max(0.0, float(e.getRawY()) - self.y0))
            elif a == 1 or a == 3:
                if float(self.wrap.getTranslationY()) > ui_dp(110):
                    self.plugin.ui_close_sheet()
                else:
                    self.wrap.animate().setStartDelay(0).translationY(0.0) \
                        .setDuration(420).setInterpolator(_Over(1.2)).start()
        except Exception:
            pass
        return True

class _uiKbLayout(dynamic_proxy(_View.OnLayoutChangeListener)):

    def __init__(self, plugin, wrap):
        super().__init__()
        self.plugin = plugin
        self.wrap = wrap

    def onLayoutChange(self, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
        try:
            nh, oh = int(bottom - top), int(oldBottom - oldTop)
            if oh <= 0 or nh == oh or nh <= 0:
                return
            if getattr(self.plugin, "_ui_sheet_closing", False):
                return
            import time as _t
            if _t.time() - getattr(self.plugin, "_ui_open_t", 0.0) < 0.55:
                return
            delta = float(nh - oh)
            self.wrap.animate().cancel()
            self.wrap.setTranslationY(float(self.wrap.getTranslationY()) - delta)
            self.wrap.animate().setStartDelay(0).translationY(0.0).setDuration(280) \
                .setInterpolator(ui_emph_dec()).start()
        except Exception:
            pass

def ui_switch(ctx, checked):

    TW, TH = 52, 32
    PAD_OFF = 6                            
    PAD_ON = 4                             
    box = _FrameLayout(ctx)
    r_track = float(ui_dp(TH)) / 2.0

    def track_d(on):
        g = GradientDrawable()
        if on:
            g.setColor(ui_signed(UI_PALETTE["primary"]))
            g.setCornerRadius(r_track)
        else:
            g.setColor(ui_signed(UI_PALETTE["surface_container_highest"]))
            g.setCornerRadius(r_track)
            g.setStroke(ui_dp(2), ui_signed(UI_PALETTE["outline"]))
        return g

    def thumb_d(on):
        g = GradientDrawable()
        g.setShape(GradientDrawable.OVAL)
        if on:
            g.setColor(ui_signed(UI_PALETTE["on_primary"]))
        else:
            g.setColor(ui_signed(UI_PALETTE["outline"]))
        return g

    track = _View(ctx)
    box.addView(track, ui_frm(ui_dp(TW), ui_dp(TH)))
    thumb = _View(ctx)
    box.addView(thumb, ui_frm(ui_dp(24), ui_dp(24), _Gravity.LEFT | _Gravity.CENTER_VERTICAL,
                               (2, 0, 0, 0)))

    state = {"f": 1.0 if checked else 0.0, "anim": None}

    def apply(f):
                                                                  
        state["f"] = f
        track.setBackground(track_d(f >= 0.5))
        thumb.setBackground(thumb_d(f >= 0.5))
        try:
            s = (16.0 + 8.0 * f) / 24.0
            thumb.setScaleX(float(s))
            thumb.setScaleY(float(s))
            thumb.setTranslationX(float(ui_dp(24) * f))
            thumb.requestLayout()
        except Exception:
            pass

    def set_checked(value, animate=True):
        target = 1.0 if value else 0.0
        start = state["f"]
        if not animate or start == target:
            apply(target)
            return

        TOTAL = 10
        state["anim"] = target

        def tick(i):
            try:
                if state["anim"] is not target:
                    return
                t = float(i) / float(TOTAL)
                if t >= 1.0:
                    apply(target)
                    state["anim"] = None
                    return
                e = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t)                  
                apply(start + (target - start) * e)
                _run_ui(lambda: tick(i + 1), 18)
            except Exception:
                apply(target)
                state["anim"] = None

        _run_ui(lambda: tick(1), 18)

    apply(state["f"])
    return box, set_checked

def ui_slider(ctx, maximum, progress, on_change):

    sb = _SeekBar(ctx)
    sb.setMax(int(maximum))
    try:
        bg = ui_rounded(UI_PALETTE["surface_container_highest"], 2)
        bg.setSize(-1, ui_dp(4))
        fg = ui_rounded(UI_PALETTE["primary"], 2)
        fg.setSize(-1, ui_dp(4))
        clip = ClipDrawable(fg, _Gravity.LEFT, ClipDrawable.HORIZONTAL)
        layers = LayerDrawable(jarray(Drawable)([bg, clip]))
        rid = jclass("android.R$id")
        layers.setId(0, rid.background)
        layers.setId(1, rid.progress)
        thumb = ui_rounded(UI_PALETTE["primary"], 2)
        thumb.setSize(ui_dp(4), ui_dp(36))
        sb.setProgressDrawable(layers)
        sb.setThumb(thumb)
        sb.setThumbOffset(ui_dp(0))
        sb.setSplitTrack(False)
        sb.setBackground(None)
        sb.setPadding(ui_dp(16), ui_dp(10), ui_dp(16), ui_dp(10))
    except Exception:
        pass
    sb.setProgress(int(progress))
    sb.setOnSeekBarChangeListener(_uiSeek(on_change))
    return sb

class _uiFocusSave(dynamic_proxy(_View.OnFocusChangeListener)):

    def __init__(self, fn, transform=None):
        super().__init__()
        self.fn = fn
        self.transform = transform

    def onFocusChange(self, v, has_focus):
        try:
            if not bool(has_focus):
                val = str(v.getText().toString())
                if self.transform is not None:
                    val = self.transform(val)
                self.fn(val)
        except Exception:
            pass

def ui_field(ctx, label, value, on_save, numeric=False, suffix=None):
                                                                                           
    box = _LinearLayout(ctx)
    box.setOrientation(_LinearLayout.VERTICAL)
    head = ui_label(ctx, label)
    head.setPadding(ui_dp(4), 0, 0, 0)
    box.addView(head, ui_lin(-2, -2, None, (0, 0, 0, 4)))
    wrap = _FrameLayout(ctx)
    container = LayerDrawable(jarray(Drawable)([
        ui_rounded(UI_PALETTE["surface_container_high"], 12, [12, 12, 12, 12, 12, 12, 12, 12]),
        ui_rounded(UI_PALETTE["primary"], 2),
    ]))
    container.setLayerInset(1, ui_dp(0), ui_dp(40), ui_dp(0), 0)
    ui_set_bg(wrap, container)
    e = _EditText(ctx)
    e.setText(str(value if value is not None else ""))
    e.setTextColor(ui_signed(UI_PALETTE["on_surface"]))
    e.setTextSize(17.0)
    try:
        e.setHintTextColor(ui_signed(UI_PALETTE["on_surface_variant"]))
    except Exception:
        pass
    if numeric:
        e.setInputType(_InputType.TYPE_CLASS_NUMBER)
    e.setBackground(None)
    e.setSingleLine(True)
    e.setPadding(ui_dp(16), ui_dp(10), ui_dp(16), ui_dp(10))
    wrap.addView(e, ui_frm(-1, -2))
    if suffix:
        s = ui_text(ctx, suffix, 14, UI_PALETTE["on_surface_variant"], gravity=_Gravity.CENTER_VERTICAL)
        wrap.addView(s, ui_frm(-2, -1, _Gravity.RIGHT | _Gravity.CENTER_VERTICAL, (0, 0, 12, 0)))
    e.setOnFocusChangeListener(_uiFocusSave(on_save))
    box.addView(wrap, ui_lin(-1, ui_dp(40)))
    return box, e

def ui_filled_btn(ctx, text, on_click, color=None, text_color=None):
    b = ui_text(ctx, text, 16, text_color or UI_PALETTE["on_primary"], True, _Gravity.CENTER)
    ui_set_bg(b, ui_ripple(color or UI_PALETTE["primary"], 20))
    b.setPadding(ui_dp(16), ui_dp(4), ui_dp(16), ui_dp(4))
    b.setMinimumHeight(ui_dp(48))
    ui_on_click(b, on_click)
    return b

def ui_tonal_btn(ctx, text, on_click):
    return ui_filled_btn(ctx, text, on_click,
                         UI_PALETTE["secondary_container"], UI_PALETTE["on_secondary_container"])

def ui_outlined_btn(ctx, text, on_click):
    b = ui_text(ctx, text, 16, UI_PALETTE["primary"], True, _Gravity.CENTER)
    g = GradientDrawable()
    g.setColor(0)
    g.setCornerRadius(float(ui_dp(20)))
    g.setStroke(ui_dp(1), ui_signed(UI_PALETTE["outline"]))
    ui_set_bg(b, g)
    b.setPadding(ui_dp(16), ui_dp(4), ui_dp(16), ui_dp(4))
    b.setMinimumHeight(ui_dp(48))
    ui_on_click(b, on_click)
    return b

def ui_card(ctx, radius=16, color=None):
                                                                    
    c = _LinearLayout(ctx)
    c.setOrientation(_LinearLayout.VERTICAL)
    ui_set_bg(c, ui_rounded(color or UI_PALETTE["surface_container"], radius))
    c.setPadding(ui_dp(16), ui_dp(14), ui_dp(16), ui_dp(6))
    return c

def ui_section(ctx, title, items=None):
                                                                         
    root = _LinearLayout(ctx)
    root.setOrientation(_LinearLayout.VERTICAL)
    root.addView(ui_label(ctx, title), ui_lin(-2, -2, None, (4, 0, 4, 8)))
    card = ui_card(ctx)
    root.addView(card, ui_lin(-1, -2))
    return root, card

def ui_chip(ctx, text, selected, on_click):
                                                       
    c = ui_text(ctx, text, 14, UI_PALETTE["on_secondary_container"] if selected else UI_PALETTE["on_surface_variant"],
                 selected, _Gravity.CENTER)
    c.setPadding(ui_dp(12), ui_dp(6), ui_dp(12), ui_dp(6))
    if selected:
        ui_set_bg(c, ui_rounded(UI_PALETTE["secondary_container"], 8))
    else:
        g = GradientDrawable()
        g.setColor(0)
        g.setCornerRadius(float(ui_dp(8)))
        g.setStroke(ui_dp(1), ui_signed(UI_PALETTE["outline_variant"]))
        ui_set_bg(c, g)
    ui_on_click(c, on_click)
    return c

def ui_row(ctx, title, sub=None, right=None, on_click=None, pad=16):
                                                                                   
    row = _LinearLayout(ctx)
    row.setOrientation(_LinearLayout.HORIZONTAL)
    row.setGravity(_Gravity.CENTER_VERTICAL)
    ui_set_bg(row, ui_ripple(UI_PALETTE["surface_container"], 16))
    row.setPadding(ui_dp(pad), ui_dp(12), ui_dp(pad), ui_dp(12))
    col = _LinearLayout(ctx)
    col.setOrientation(_LinearLayout.VERTICAL)
    title_view = ui_body(ctx, title, 17, UI_PALETTE["on_surface"])
    col.addView(title_view)
    subtitle_view = None
    if sub:
        subtitle_view = ui_support(ctx, sub)
        col.addView(subtitle_view)
    row.addView(col, ui_lin(0, -2, 1))
    if right is not None:
        row.addView(right, ui_lin(-2, -2, None, (8, 0, 0, 0)))
    if on_click is not None:
        for target in (row, col, title_view, subtitle_view):
            if target is not None:
                try:
                    target.setClickable(True)
                    target.setFocusable(True)
                except Exception:
                    pass
                ui_on_click(target, on_click, press=False)
    return row

def ui_switch_row(ctx, label, sub, checked, on_change):
    row = _LinearLayout(ctx)
    row.setOrientation(_LinearLayout.HORIZONTAL)
    row.setGravity(_Gravity.CENTER_VERTICAL)
    ui_set_bg(row, ui_ripple(UI_PALETTE["surface_container"], 16))
    row.setPadding(ui_dp(16), ui_dp(6), ui_dp(16), ui_dp(6))
    col = _LinearLayout(ctx)
    col.setOrientation(_LinearLayout.VERTICAL)
    col.addView(ui_body(ctx, label, 17, UI_PALETTE["on_surface"]))
    if sub:
        col.addView(ui_support(ctx, sub))
    row.addView(col, ui_lin(0, -2, 1))
    sw, set_checked = ui_switch(ctx, bool(checked))
    row.addView(sw, ui_lin(-2, -2, None, (12, 0, 0, 0)))

    def toggle(v):
        new = not bool(getattr(row, "_ui_val", checked))
        setattr(row, "_ui_val", new)
        set_checked(new, True)
        try:
            on_change(new)
        except Exception:
            pass

    setattr(row, "_ui_val", bool(checked))
    ui_on_click(row, toggle)
    return row, set_checked

