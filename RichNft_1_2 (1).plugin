        hero = ui_card(ctx, 16, UI_PALETTE["surface_container_high"])
        hero.addView(ui_text(ctx, "Визуальные подарки и профиль", 20, UI_PALETTE["on_surface"], True))
        hero.addView(ui_support(ctx, "Всё локально: без сервера, видно только вам"),
                     ui_lin(-2, -2, None, (0, 2, 0, 6)))
