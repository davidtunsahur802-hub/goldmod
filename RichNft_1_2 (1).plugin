        card.addView(sw, ui_lin(-1, -2, None, (0, 4, 0, 0)))
        f, _e = ui_field(ctx, "Звёзды", self._ui_get("balance_value", "67"),
                          lambda s: self._ui_set("balance_value", s), numeric=True)
        card.addView(f, ui_lin(-1, -2, None, (0, 10, 0, 0)))
        sw2, _ = ui_switch_row(
            ctx, "Подмена баланса грам", "",
